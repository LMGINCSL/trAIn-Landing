  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lmginc-onboarding-check.sh\"",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_core.py\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "guard del repo"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/public_guard.py\" pre-git",
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "guard de repo publico"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_core.py\"",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "guard del repo"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/public_guard.py\" pre-edit",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "migraciones aplicadas"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/public_guard.py\" post-edit",
            "timeout": 15,
            "onFailure": "continue",
            "statusMessage": "repo publico: revisando lo escrito"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/py.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_check.py\"",
            "timeout": 20,
            "onFailure": "continue",
            "statusMessage": "ES/EN, generadas y ?v="
          }
        ]
      }
    ]
  }
}
